{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StitchVue",
  "version": "0.1.0",
  "identifier": "com.stitchvue.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StitchVue",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/StitchVue/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
