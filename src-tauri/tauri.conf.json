{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "StitchVue",
    "version": "0.1.0",
    "identifier": "com.stitchvue.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "StitchVue",
                "width": 1280,
                "height": 800,
                "minWidth": 720,
                "minHeight": 480,
                "theme": "Dark",
                "backgroundColor": "#0d0f12"
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["$LOCALDATA/StitchVue/**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "languages": ["English", "Russian"]
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NDMyQjQ5QjU0MDI4NDYKUldSR0tFQzFTU3REbHRnWkdIN2lYZ3AwM1R1Q0ZwYXU0VHZnWDZsRFM3OWNwRGNFQS9FSG9EUVkK",
            "endpoints": [
                "https://github.com/PavelKull/StitchVue/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
