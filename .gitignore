# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor / IDE (local only)
.vscode/
.idea/

# Cursor: ignore local IDE/MCP state; track shared agents, rules, skills
.cursor/*
!.cursor/agents/
!.cursor/agents/**
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**

# Secrets / env / local credentials (anywhere)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
**/mcp.json

# Project technical docs and refactoring TASK files are tracked
# (do not ignore docs/)

.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local test corpus (HEIC/RAW samples, not committed)
/fixtures-local/

# Python bytecode from icon helpers
__pycache__/
*.py[cod]
